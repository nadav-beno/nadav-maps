{
  "name": "nadav-maps",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --filter @nm/web dev",
    "build": "pnpm --filter @nm/web build",
    "preview": "pnpm --filter @nm/web preview",
    "server": "pnpm --filter @nm/server start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "boundaries": "node scripts/check-boundaries.mjs",
    "check": "pnpm boundaries && pnpm typecheck && pnpm test && pnpm build",
    "new-feature": "node scripts/new-feature.mjs"
  },
  "devDependencies": {
    "@material-symbols/svg-400": "0.48.0",
    "@playwright/test": "1.56.1",
    "@types/node": "^22.0.0",
    "geojson-vt": "5.0.4",
    "pmtiles": "4.5.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "vt-pbf": "3.1.3"
  }
}
